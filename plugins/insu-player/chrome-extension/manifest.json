{
  "manifest_version": 3,
  "name": "INSU Player",
  "version": "0.2.0",
  "description": "把目前 Chrome 分頁中的影音送到本機 INSU Player。",
  "action": {
    "default_title": "加入 INSU Player",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
